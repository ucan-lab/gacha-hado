    "@inlang/paraglide-sveltekit": "^0.16.0",
    "@tabler/icons-svelte": "^3.29.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.0.0",
    "postcss": "^8.5.1"
